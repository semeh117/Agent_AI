LLM_PROVIDER=openrouter
# Agent 1 continues to use LLM_PROVIDER and its provider-specific model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# OpenRouter pre-authorizes max_tokens per call against your credit balance.
# The agent's tool inputs are deliberately small (jobs are evaluated by url),
# so a low cap keeps each step affordable and stays well under the 32k context.
OPENROUTER_MAX_TOKENS=2048

# Agent 2 model roles. These can be changed independently for comparisons.
PARSER_PROVIDER=openrouter
# Qwen 2.5's corresponding Instruct size is 7B (there is no official 8B).
PARSER_MODEL=qwen/qwen-2.5-7b-instruct
PARSER_MAX_TOKENS=2048

AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-120b
AGENT_MAX_TOKENS=2048

COVER_LETTER_PROVIDER=gemini
COVER_LETTER_MODEL=gemini-2.5-flash-lite
COVER_LETTER_MAX_TOKENS=1200

# Groq counts this completion allowance together with prompt tokens against
# the account's tokens-per-minute limit. Keep it modest for the on-demand tier.
GROQ_MAX_TOKENS=2048

# Description length the agent sees per posting (default 20000 = effectively
# full). With results_count=3 the full text fits; lower it if context/credits
# ever get tight again. The FULL stored description is always used for
# scoring regardless of this cap.
JOB_DESCRIPTION_SUMMARY_CHARS=20000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Reuse downloaded weights without contacting huggingface.co on each run.
# Set false only once when intentionally downloading a different model.
EMBEDDING_LOCAL_ONLY=true

# Agent 2 application data and future LangGraph checkpoints. This database is
# separate from Agent 1's cache/seen_jobs_memory.db.
AGENT2_DATABASE_PATH=runtime/agent2.sqlite3

# Telegram delivery (agent/tools/telegram_tool.py -> pipeline/send_results_telegram.py)
# Get a token from @BotFather; get your personal chat id from @userinfobot
